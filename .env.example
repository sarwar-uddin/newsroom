# Copy to .env and replace every value. Never commit .env.

# --- PostgreSQL (used by docker-compose.yml) ---
POSTGRES_USER=newsroom
POSTGRES_PASSWORD=change_me_dev_only
POSTGRES_DB=newsroom
POSTGRES_PORT=5433

# --- Application ---
# Connection string used by the web app, migrations, seed and CLI scripts.
DATABASE_URL=postgres://newsroom:change_me_dev_only@127.0.0.1:5433/newsroom

# Public origin of the site, no trailing slash. Used for canonical URLs, RSS, sitemap, OG tags
# and the server-action origin check.
SITE_URL=http://localhost:3000

# Local media storage directory (relative to apps/web or absolute). Not used by S3 storage.
UPLOAD_DIR=./storage/uploads

# Maximum upload size in bytes (default 8 MiB).
MEDIA_MAX_BYTES=8388608

# --- Tests only ---
# A separate, disposable database. Integration and e2e tests TRUNCATE every table in it.
TEST_DATABASE_URL=postgres://newsroom:test_only_password@127.0.0.1:5434/newsroom_test
